# Production feature switches for forgehub-backend (no secrets here).
#
# docker-compose.yml loads this file after .env, so every `docker compose up` --
# from any session or script -- starts the backend with the same switches.
# Change a value only with Marcelo's approval, in a commit; Auditor ECO-072
# compares the running container with this file on origin/main.
# (2026-11-15: a deploy without these values turned the on-demand Messages
# analysis off.) Code defaults (app/core/config.py) stay off for every switch.
BACKGROUND_WORKERS_ENABLED=true
MISSION_TOOLS_ENABLED=true
MISSION_CYCLE_ENABLED=false
MESSAGE_TRIAGE_ENABLED=false
MESSAGE_ANALYSIS_ON_DEMAND_ENABLED=true
RUNTIME_CONTRACT_ENABLED=false
NATIVE_DELEGATION_ENABLED=false
PUBLISH_PROOF_RECHECK_ENABLED=false
TASK_BROWSER_ENABLED=false
MISSION_LEARNING_ENABLED=false
REMOTE_COLLABORATION_ENABLED=false

[Unit]
Description=Compact aged Hindsight documents into ForgeHub Knowledge Base
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/project/forgehub
ExecStart=/usr/bin/python3 /root/project/forgehub/host-bridge/hindsight_retention.py run
UMask=0077
NoNewPrivileges=true
TimeoutStartSec=45min

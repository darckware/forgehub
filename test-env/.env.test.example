# Template for test-env/.env.test (the real file is out of git).
# Create it -- random password and test-only credentials -- with:
#   test-env/init-env.sh
# (./dev.sh runs it every start; it never changes a value already set, and
# replaces only the `change-me` placeholders and keys that are missing.)
#
# Read by test-env/docker-compose.yml (the container's password) and, under
# ENVIRONMENT=test, by the backend (app/core/config.py) instead of the
# repo-root .env. Only forgehub_test@127.0.0.1:5439 passes the test guard.
ENVIRONMENT=test
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5439
POSTGRES_DB=forgehub_test
POSTGRES_USER=forgehub_test
POSTGRES_PASSWORD=change-me
POSTGRES_SCHEMA=company

# Test-only credentials (Plano Integrado T.3). Under ENVIRONMENT=test the
# backend refuses to start if any of these is unset, the code default, equal
# to another, or equal to a production secret (SHA-256 compared with the
# repo-root .env, or with test-env/.prod-secret-hashes inside the containers).
JWT_SECRET=change-me
CHAT_BRIDGE_TOKEN=change-me
SECRETS_ENCRYPTION_KEY=change-me
AGENT_ACTIVITY_WEBHOOK_SECRET=change-me
DARCKWARE_AGENT_TOKEN=change-me
DARCKWARE_APPROVER_TOKEN=change-me
# ForgeRouter: the only key the stub accepts; every agent uses it under test.
# Always frtest_<random> (init-env.sh); no key is stored in the test database.
FORGEROUTER_TEST_API_KEY=change-me

# Integrations: only the local stub (forgehub_test_stubs) or empty. These are
# the host addresses (through forgehub_test_gateway) used by dev.sh and
# pytest on the host; the test containers override them with
# http://forgehub_test_stubs:8900/... in docker-compose.yml.
CHAT_BRIDGE_URL=http://127.0.0.1:8003
DARCKWARE_API_URL=http://127.0.0.1:8003/darckware
FORGEROUTER_URL=http://127.0.0.1:8003/forgerouter
TAILSCALE_API_URL=http://127.0.0.1:8003/tailscale
WEATHER_API_URL=http://127.0.0.1:8003/weather
WEATHER_REVERSE_GEOCODE_URL=http://127.0.0.1:8003/weather

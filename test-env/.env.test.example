# Template for test-env/.env.test (the real file is out of git).
# Create it with a random password:
#   sed "s/^POSTGRES_PASSWORD=.*/POSTGRES_PASSWORD=$(openssl rand -hex 24)/" \
#     test-env/.env.test.example > test-env/.env.test && chmod 600 test-env/.env.test
# (./dev.sh does this for you when the file is missing.)
#
# Read by test-env/docker-compose.yml (the container's password) and, under
# ENVIRONMENT=test, by the backend (app/core/config.py) instead of the
# repo-root .env. Only forgehub_test@127.0.0.1:5439 passes the test guard.
ENVIRONMENT=test
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5439
POSTGRES_DB=forgehub_test
POSTGRES_USER=forgehub_test
POSTGRES_PASSWORD=change-me
POSTGRES_SCHEMA=company
